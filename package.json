{
  "name": "mdn-local",
  "version": "0.7.4",
  "description": "create offline mozilla developer network documents",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "agentkeepalive": "^4.6.0",
    "fast-glob": "^3.3.3",
    "json5": "^2.2.3",
    "log4js": "^6.9.1",
    "mkdirp": "^3.0.1",
    "tough-cookie": "^6.0.2",
    "urijs": "^1.19.11",
    "website-scrap-engine": "^0.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@types/node": "^26.2.0",
    "@types/tough-cookie": "^4.0.5",
    "@types/urijs": "^1.19.26",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "undici": "npm:@favware/skip-dependency@1.2.2"
  },
  "scripts": {
    "test": "npm run lint && node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint --fix src test",
    "clean": "node -e \"require('fs').rmSync('lib',{force:true,recursive:true})\"",
    "tsc": "tsc",
    "build": "npm run lint && npm run tsc && npm run copy",
    "copy": "node copy-src.js",
    "update:official-redirects": "node scripts/update-official-external-redirects.mjs",
    "check:official-redirects": "node scripts/update-official-external-redirects.mjs --check",
    "prepack": "npm run clean && npm run build",
    "postshrinkwrap": "node package-lock-resolved.js",
    "postinstall": "node -e \"try{require('fs').copyFileSync('fake-undici.d.ts', 'node_modules/cheerio/node_modules/undici/index.d.ts')}catch(e){require('fs').copyFileSync('fake-undici.d.ts', 'node_modules/undici/index.d.ts')}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/website-local/mdn-local.git"
  },
  "keywords": [
    "mdn"
  ],
  "author": "myfreeer",
  "license": "MPL-2.0"
}
